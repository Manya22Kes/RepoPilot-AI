{
  "name": "github-ops-agent",
  "version": "0.6.0",
  "private": true,
  "description": "Production-grade AI automation agent for GitHub repository operations (Phases 1-6: GitHub App foundation, core triage engine, LLM reasoning layer, stale-PR detection/release notes/docs-sync, reliability & observability, dashboard & deployment).",
  "main": "src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "worker": "node src/worker.js",
    "migrate": "node src/db/runMigrations.js",
    "test": "jest --runInBand",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "bullmq": "^5.12.12",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^6.3.4"
  }
}
